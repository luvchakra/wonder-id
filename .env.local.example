# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.
#
# For deployment, set these as encrypted environment variables in the
# hosting platform's project settings (e.g. Vercel), never in a committed file.

# Safe for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to browser code, logs, or source control.
SUPABASE_SERVICE_ROLE_KEY=

# Vendor console (/platform-admin): extra platform administrators, by email,
# comma-separated, in addition to the platform_admins table. An address
# counts only for an account whose email Supabase Auth has confirmed.
# Remove an address and redeploy to take the access away. Not a secret.
PLATFORM_ADMIN_EMAILS=

# Server-only. Symmetric key used by lib/security/encryptSecret.ts for
# envelope-encrypting integration credentials and other stored secrets.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Server-only, optional (PLATFORM-P0-05.2). The platform-wide default
# OpenAI/Gemini API keys used by lib/ai/summarize.ts for tenants that have
# not configured their own bring-your-own-key. Leave unset to run
# BYOK-only — tenants without their own key will see "Connect an AI
# provider" instead of a summary.
PLATFORM_OPENAI_API_KEY=
PLATFORM_GEMINI_API_KEY=

# Server-only, optional (OPERATIONS-P0-02.1). Resend powers the email
# channel for the 7 mandatory P0 notification types. Leave both unset to
# run in-app-only — no error, notify() just skips the email send.
# RESEND_FROM_EMAIL must be an address on a domain verified in your Resend
# account (https://resend.com/domains), e.g. notifications@yourdomain.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only, optional fallback (careers page, 2026-10-21). WonderID's open
# positions and applications are run by WonderJobs. Normally a platform
# administrator pastes the career-site key in the vendor console
# (/platform-admin/careers), stored encrypted, with no deployment needed;
# these variables apply only when nothing is saved there. Never expose the key
# to the browser. Unset everywhere: the careers page says positions can't be shown. WONDERJOBS_CAREERS_URL defaults to
# https://jobs.wonderapps.biz (only https *.wonderapps.biz hosts are accepted).
WONDERJOBS_CAREERS_KEY=
WONDERJOBS_CAREERS_URL=

# Server-only (COMPLIANCE-P0-05). Shared secret Vercel Cron sends as
# `Authorization: Bearer $CRON_SECRET` when invoking
# app/api/cron/compliance-escalate-overdue/route.ts on the schedule
# defined in vercel.json. Set the same value in the hosting platform's
# encrypted environment variables. Generate with: openssl rand -base64 32
CRON_SECRET=

# Server-only, optional (INTEGRATION-P0-11). The outbound SSRF guard refuses
# connector URLs on loopback, private, link-local and other internal
# networks, and http:// addresses. Set to exactly "true" ONLY for local
# development or the test suite (whose MCP stubs listen on 127.0.0.1).
# Never set it in production. Cloud metadata endpoints stay blocked even
# when it is set.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=

# FOUNDATION-P0-22 — tenant addresses. With this set, each organization is
# reached at https://<slug>.<BASE_APP_HOST> (e.g. BASE_APP_HOST=wonderid.example
# gives https://acme.wonderid.example). The address only names the
# organization: access still needs an active membership there. The bare host
# keeps the organization switcher. Production needs a wildcard domain
# (*.<BASE_APP_HOST>) on the Vercel project. Local development and the E2E
# suite use BASE_APP_HOST=localhost (Chromium resolves *.localhost to this
# machine). Leave unset to disable tenant addresses entirely.
BASE_APP_HOST=

# ---------------------------------------------------------------------------
# PLATFORM-P1-04 — Billing (2026-10-01). All server-only and optional: with
# none set, the Billing screen says online payment is not set up. Card, UPI
# and bank details are entered only on the provider's hosted pages.
# Stripe (USD/EUR): secret key and the signing secret of the webhook
# endpoint https://<app>/api/v1/billing/webhooks/stripe (API version 2024-06-20).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" to have Stripe Tax compute VAT/sales tax on checkout.
STRIPE_AUTOMATIC_TAX=
# Razorpay (INR): key id/secret, and the secret of the webhook endpoint
# https://<app>/api/v1/billing/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The supplier's GSTIN (and optionally its two-digit state code) for
# CGST/SGST vs IGST on Indian invoices.
BILLING_SUPPLIER_GSTIN=
BILLING_SUPPLIER_STATE_CODE=
# Owner decision 2026-10-13: while neither Stripe nor Razorpay is configured, an
# owner buys an environment with a test payment (no money moves). Set to false
# to turn that off sooner. Ignored once a provider is configured.
BILLING_TEST_PAYMENTS=
# The app's public origin, used for payment return URLs (never the request
# Host header), e.g. https://app.wonderid.example
APP_BASE_URL=

# FOUNDATION-P0-30 — encryption key rotation. Retired keys, comma separated,
# newest first: decryption falls back to them; new values use
# SECRET_ENCRYPTION_KEY. Remove once stored values are re-encrypted.
SECRET_ENCRYPTION_KEY_PREVIOUS=

# WID-H08 — the header your trusted edge or load balancer overwrites with the
# caller's address (self-hosted only; Vercel needs nothing). Automation
# credentials limited to certain addresses are refused while the address is
# unknown. Example: CLIENT_IP_HEADER=x-forwarded-for behind an ingress that
# replaces it, or cf-connecting-ip behind Cloudflare.
CLIENT_IP_HEADER=

# Owner request 2026-10-13: when true (production), the main address (BASE_APP_HOST) is the landing
# page and the product opens only on <org>[-env].<BASE_APP_HOST>. Leave unset locally and in previews.
ORG_ADDRESS_REQUIRED=
